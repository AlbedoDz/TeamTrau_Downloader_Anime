# Application Environment (development, staging, production)
APP_ENV=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API Keys (Place your credentials here in your local .env file)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Proxy Configuration (if your machine has no direct internet or site is blocked)
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

